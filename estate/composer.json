{
    "name": "manojrevenkar12-web/client-estate-ops",
    "description": "Ops core for an agency's delivered client estate: advisories, gated updates, canary verdicts, paging and cloud cost findings.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": { "Estate\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Estate\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress",
        "cs": "phpcs --standard=PSR12 src tests bin public"
    },
    "config": { "sort-packages": true }
}
